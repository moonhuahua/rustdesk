+#[cfg(test)]
+mod locked_server_policy_tests {
+    use super::*;
+
+    #[test]
+    fn locked_server_policy_rejects_overrides() {
+        for &(key, expected) in LOCKED_SERVER_OPTIONS {
+            Config::set_option(key.into(), "attacker.invalid:1".into());
+            assert_eq!(Config::get_option(key), expected);
+        }
+        let mut incoming = HashMap::new();
+        for &(key, _) in LOCKED_SERVER_OPTIONS {
+            incoming.insert(key.to_string(), "attacker.invalid:1".into());
+        }
+        Config::set_options(incoming);
+        *EXE_RENDEZVOUS_SERVER.write().unwrap() = "filename.invalid:1".into();
+        for &(key, expected) in LOCKED_SERVER_OPTIONS {
+            assert_eq!(Config::get_option(key), expected);
+            assert_eq!(Config::get_options().get(key).map(String::as_str), Some(expected));
+        }
+        assert_eq!(Config::get_rendezvous_server(), "ddns.1728333.xyz:21116");
+        assert_eq!(Config::get_rendezvous_servers(), vec!["ddns.1728333.xyz:21116"]);
+        LocalConfig::set_option("enable-check-update".into(), "Y".into());
+        assert_eq!(LocalConfig::get_option("enable-check-update"), "N");
+        assert_eq!(Config::locked_server_option("unrelated-setting"), None);
+    }
